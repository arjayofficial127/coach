{
  "schemaVersion": 1,
  "name": "Coach Browser / lattice",
  "scopes": [".", "website/frontend"],
  "commands": {
    "framework-tests": {
      "runtime": "node",
      "entry": "scripts/ai/framework.test.mjs",
      "args": ["--test", "--test-reporter=tap", "scripts/ai/framework.test.mjs"],
      "cwd": ".",
      "reviewed": true,
      "timeoutMs": 60000,
      "parser": "tap",
      "evidence": "scripts/ai/framework.test.mjs"
    },
    "typecheck": {
      "runtime": "node",
      "entry": "node_modules/typescript/bin/tsc",
      "args": ["node_modules/typescript/bin/tsc", "--noEmit"],
      "cwd": ".",
      "reviewed": true,
      "timeoutMs": 120000,
      "parser": "exit",
      "evidence": "package.json"
    },
    "app-unit": {
      "runtime": "node",
      "entry": "node_modules/vitest/vitest.mjs",
      "args": ["node_modules/vitest/vitest.mjs", "run", "--reporter=json"],
      "cwd": ".",
      "reviewed": true,
      "timeoutMs": 180000,
      "parser": "vitest-json",
      "evidence": "vitest.config.ts"
    },
    "navigation-tests": {
      "runtime": "node",
      "entry": "node_modules/vitest/vitest.mjs",
      "args": [
        "node_modules/vitest/vitest.mjs",
        "run",
        "src/main/policies/navigation.test.ts",
        "src/renderer/focus-model.test.ts",
        "--reporter=json"
      ],
      "cwd": ".",
      "reviewed": true,
      "timeoutMs": 60000,
      "parser": "vitest-json",
      "evidence": "vitest.config.ts"
    },
    "website-typecheck": {
      "runtime": "node",
      "entry": "node_modules/typescript/bin/tsc",
      "args": ["node_modules/typescript/bin/tsc", "--noEmit"],
      "cwd": "website/frontend",
      "reviewed": true,
      "timeoutMs": 120000,
      "parser": "exit",
      "evidence": "website/frontend/package.json"
    }
  }
}
